# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/syllabus_calendar

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Override either model independently. Defaults are claude-haiku-4-5 for both.
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_PARSE_MODEL=claude-haiku-4-5
# Min extracted-text length before we trust pypdf and skip the PDF upload.
# PARSE_TEXT_MIN_CHARS=400

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# JWT
JWT_SECRET=change_me_to_a_long_random_string_generated_with_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Encryption key for refresh tokens at rest (Fernet key)
REFRESH_TOKEN_ENCRYPTION_KEY=change_me_use_Fernet_generate_key_output

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_ENV=development
LOG_LEVEL=INFO
